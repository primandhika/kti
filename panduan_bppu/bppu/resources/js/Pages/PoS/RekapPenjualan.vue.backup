<template>
  <component :is="layoutComponent" pageTitle="Rekap Penjualan">
    <div class="min-h-screen bg-gray-50">
      <!-- Compact Header with Summary - Responsive -->
      <div class="bg-white border-b sticky top-14 z-20 shadow-sm">
        <div class="p-3">
          <!-- Desktop: All in One Row -->
          <div class="hidden lg:flex items-center gap-3 mb-3">
            <!-- Summary Cards - Compact -->
            <div class="bg-[#eae0cc] rounded-lg px-3 py-1.5 min-w-[100px]">
              <div class="text-[#6b4700] text-[10px] uppercase font-medium">Transaksi</div>
              <div class="text-[#996600] font-bold text-base">{{ summary.total_transaksi }}</div>
            </div>
            <div class="bg-green-50 rounded-lg px-3 py-1.5 min-w-[120px]">
              <div class="text-gray-600 text-[10px] uppercase font-medium">Total</div>
              <div class="text-green-900 font-bold text-base">{{ formatCurrency(summary.total_penjualan) }}</div>
            </div>

            <!-- Filters - Inline -->
            <div v-if="isKantinUser" class="flex gap-2 flex-1">
              <input
                v-model="filters.date"
                type="date"
                @change="applyFilters"
                class="px-2 py-1.5 text-xs border border-gray-300 rounded focus:ring-1 focus:ring-[#996600] focus:border-[#996600]"
              />
              <button
                @click="setToday"
                class="px-3 py-1.5 text-xs bg-[#996600] text-white rounded hover:bg-[#7a5100] whitespace-nowrap"
              >
                Hari Ini
              </button>
            </div>
            <div v-else class="flex gap-2 flex-1">
              <div class="flex gap-1">
                <button
                  @click="setToday"
                  :class="['px-2 py-1.5 text-xs rounded transition-colors', isToday ? 'bg-[#996600] text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200']"
                >
                  Hari Ini
                </button>
                <button
                  @click="setThisWeek"
                  :class="['px-2 py-1.5 text-xs rounded transition-colors', isThisWeek ? 'bg-[#996600] text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200']"
                >
                  Minggu Ini
                </button>
                <button
                  @click="setThisMonth"
                  :class="['px-2 py-1.5 text-xs rounded transition-colors', isThisMonth ? 'bg-[#996600] text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200']"
                >
                  Bulan Ini
                </button>
              </div>
              <input
                v-model="filters.start_date"
                type="date"
                @change="applyFilters"
                class="px-2 py-1.5 text-xs border border-gray-300 rounded focus:ring-1 focus:ring-[#996600] focus:border-[#996600]"
              />
              <input
                v-model="filters.end_date"
                type="date"
                @change="applyFilters"
                class="px-2 py-1.5 text-xs border border-gray-300 rounded focus:ring-1 focus:ring-[#996600] focus:border-[#996600]"
              />
            </div>

            <select
              v-if="workUnits.length > 1"
              v-model="filters.work_unit_id"
              @change="applyFilters"
              class="px-2 py-1.5 text-xs border border-gray-300 rounded focus:ring-1 focus:ring-[#996600] focus:border-[#996600]"
            >
              <option :value="null">Semua Unit</option>
              <option v-for="unit in workUnits" :key="unit.id" :value="unit.id">
                {{ unit.name }}
              </option>
            </select>

            <button
              @click="resetFilters"
              class="px-3 py-1.5 text-xs bg-gray-100 text-gray-700 rounded hover:bg-gray-200 whitespace-nowrap"
            >
              Reset
            </button>
          </div>

          <!-- Mobile: Stacked Layout -->
          <div class="lg:hidden">
            <!-- Summary in 1 compact card -->
            <div class="grid grid-cols-2 gap-2 text-xs mb-3">
              <div class="bg-[#eae0cc] rounded-lg p-2">
                <div class="text-[#6b4700] text-[10px] uppercase font-medium">Transaksi</div>
                <div class="text-[#996600] font-bold text-base">{{ summary.total_transaksi }}</div>
              </div>
              <div class="bg-green-50 rounded-lg p-2">
                <div class="text-gray-600 text-[10px] uppercase font-medium">Total</div>
                <div class="text-green-900 font-bold text-base">{{ formatCurrency(summary.total_penjualan) }}</div>
              </div>
            </div>

            <!-- Compact Filters -->
            <div class="space-y-2">
              <!-- Date Range - Inline or Single Date for Kantin -->
              <div v-if="isKantinUser" class="flex gap-2">
                <input
                  v-model="filters.date"
                  type="date"
                  @change="applyFilters"
                  class="flex-1 px-2 py-1.5 text-xs border border-gray-300 rounded focus:ring-1 focus:ring-[#996600] focus:border-[#996600]"
                />
                <button
                  @click="setToday"
                  class="px-3 py-1.5 text-xs bg-[#996600] text-white rounded hover:bg-[#7a5100]"
                >
                  Hari Ini
                </button>
              </div>
              <div v-else class="space-y-2">
                <!-- Quick Filter Buttons -->
                <div class="grid grid-cols-3 gap-2">
                  <button
                    @click="setToday"
                    :class="['px-2 py-1.5 text-xs rounded transition-colors', isToday ? 'bg-[#996600] text-white' : 'bg-gray-100 text-gray-700']"
                  >
                    Hari Ini
                  </button>
                  <button
                    @click="setThisWeek"
                    :class="['px-2 py-1.5 text-xs rounded transition-colors', isThisWeek ? 'bg-[#996600] text-white' : 'bg-gray-100 text-gray-700']"
                  >
                    Minggu Ini
                  </button>
                  <button
                    @click="setThisMonth"
                    :class="['px-2 py-1.5 text-xs rounded transition-colors', isThisMonth ? 'bg-[#996600] text-white' : 'bg-gray-100 text-gray-700']"
                  >
                    Bulan Ini
                  </button>
                </div>
                <!-- Date Inputs -->
                <div class="flex gap-2">
                  <input
                    v-model="filters.start_date"
                    type="date"
                    @change="applyFilters"
                    class="flex-1 px-2 py-1.5 text-xs border border-gray-300 rounded focus:ring-1 focus:ring-[#996600] focus:border-[#996600]"
                  />
                  <input
                    v-model="filters.end_date"
                    type="date"
                    @change="applyFilters"
                    class="flex-1 px-2 py-1.5 text-xs border border-gray-300 rounded focus:ring-1 focus:ring-[#996600] focus:border-[#996600]"
                  />
                </div>
              </div>

              <!-- Work Unit & Reset - Inline -->
              <div class="flex gap-2" v-if="workUnits.length > 1">
                <select
                  v-model="filters.work_unit_id"
                  @change="applyFilters"
                  class="flex-1 px-2 py-1.5 text-xs border border-gray-300 rounded focus:ring-1 focus:ring-[#996600] focus:border-[#996600]"
                >
                  <option :value="null">Semua Unit</option>
                  <option v-for="unit in workUnits" :key="unit.id" :value="unit.id">
                    {{ unit.name }}
                  </option>
                </select>
                <button
                  @click="resetFilters"
                  class="px-3 py-1.5 text-xs bg-gray-100 text-gray-700 rounded hover:bg-gray-200"
                >
                  Reset
                </button>
              </div>
            </div>
          </div>

          <!-- Bulk Actions - For Verification (Kantin, Officer & Sysadmin) -->
          <div v-if="canVerify && selectedTransactions.length > 0" class="mt-3 p-2 bg-[#eae0cc] rounded-lg border border-[#c1a366]">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs text-[#6b4700] font-medium">{{ selectedTransactions.length }} untuk verifikasi</span>
              <div class="flex gap-1">
                <button
                  @click="verifySelected"
                  class="px-2 py-1 text-xs bg-[#996600] text-white rounded hover:bg-[#7a5100] font-medium"
                >
                  Verifikasi
                </button>
                <button
                  @click="clearSelection"
                  class="px-2 py-1 text-xs bg-gray-200 text-gray-700 rounded hover:bg-gray-300"
                >
                  Batal
                </button>
              </div>
            </div>
          </div>

          <!-- Bulk Actions - For Approval (Sysadmin Only) -->
          <div v-if="canApprove && selectedForApproval.length > 0" class="mt-3 p-2 bg-green-50 rounded-lg border border-green-200">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs text-green-900 font-medium">{{ selectedForApproval.length }} untuk approve</span>
              <div class="flex gap-1">
                <button
                  @click="approveSelected"
                  class="px-2 py-1 text-xs bg-green-600 text-white rounded hover:bg-green-700 font-medium"
                >
                  Approve
                </button>
                <button
                  @click="clearApprovalSelection"
                  class="px-2 py-1 text-xs bg-gray-200 text-gray-700 rounded hover:bg-gray-300"
                >
                  Batal
                </button>
              </div>
            </div>
          </div>

          <!-- Verify All & Ringkasan Buttons - 1 Row -->
          <div class="mt-2 flex gap-2">
            <!-- Verify All Button - Officer & Sysadmin -->
            <button
              v-if="canBulkVerify"
              @click="showVerifyAllModal = true"
              class="flex-1 px-3 py-2 text-xs bg-[#996600] text-white rounded hover:bg-[#7a5100] font-medium"
            >
              Verifikasi Semua
            </button>

            <!-- Ringkasan Button -->
            <button
              @click="openItemSummaryModal"
              class="flex-1 px-3 py-2 text-xs bg-[#996600] text-white rounded hover:bg-[#7a5100] font-medium flex items-center justify-center gap-1"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              Ringkasan Item
            </button>
          </div>
        </div>
      </div>

      <!-- Transaction Cards - Grid Layout -->
      <div class="p-3">
        <!-- Grid Container -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 mb-4">
          <!-- Transaction Card -->
          <div
            v-for="penjualan in penjualans.data"
            :key="penjualan.id"
            class="bg-white rounded-lg shadow-sm border overflow-hidden"
            :class="[
              selectedTransactions.includes(penjualan.id) ? 'border-blue-500 ring-2 ring-blue-200' : 'border-gray-200'
            ]"
          >
          <!-- Card Header -->
          <div class="bg-gradient-to-r from-[#6b4700] to-[#5b3d00] px-3 py-2">
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-start gap-2 flex-1 min-w-0">
                <!-- CHECKBOX untuk Officer/Sysadmin - bisa bulk verify semua transaksi -->
                <input
                  v-if="!penjualan.is_verified && canBulkVerify"
                  type="checkbox"
                  :checked="selectedTransactions.includes(penjualan.id)"
                  @change="toggleSelection(penjualan.id)"
                  class="flex-shrink-0 w-5 h-5 rounded border-2 border-white cursor-pointer accent-blue-500 mt-0.5"
                />

                <!-- CHECKBOX untuk User Kantin - hanya transaksi sendiri -->
                <input
                  v-else-if="!penjualan.is_verified && isKantinUser && canVerifyTransaction(penjualan)"
                  type="checkbox"
                  :checked="selectedTransactions.includes(penjualan.id)"
                  @change="toggleSelection(penjualan.id)"
                  class="flex-shrink-0 w-5 h-5 rounded border-2 border-white cursor-pointer accent-blue-500 mt-0.5"
                />

                <!-- CHECKBOX untuk approval (sudah verified, belum approved) -->
                <input
                  v-else-if="penjualan.is_verified && !penjualan.is_approved && canApprove"
                  type="checkbox"
                  :checked="selectedForApproval.includes(penjualan.id)"
                  @change="toggleApprovalSelection(penjualan.id)"
                  class="flex-shrink-0 w-5 h-5 rounded border-2 border-white cursor-pointer accent-green-500 mt-0.5"
                />

                <div class="flex-1 min-w-0">
                  <button
                    @click="openDetailModal(penjualan)"
                    class="text-white font-bold text-sm truncate hover:text-[#c1a366] transition-colors text-left w-full"
                  >
                    {{ penjualan.nomor_transaksi }}
                  </button>
                  <div class="text-[#c1a366] text-xs">{{ formatDateTime(penjualan.tanggal_transaksi) }}</div>
                </div>
              </div>
              <!-- Status Badge -->
              <span
                class="text-xs px-2 py-0.5 rounded-full font-medium flex-shrink-0"
                :class="getStatusClass(penjualan)"
              >
                {{ getStatusText(penjualan) }}
              </span>
            </div>
          </div>

          <!-- Card Body -->
          <div class="p-3 space-y-2">
            <!-- Items List - Compact with elipsis -->
            <div class="text-xs text-gray-700">
              <div class="flex items-start gap-1.5">
                <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
                <span class="flex-1 line-clamp-2 leading-tight">
                  {{ getItemsText(penjualan.items) }}
                </span>
              </div>
            </div>

            <!-- Info Row - Kasir & Metode -->
            <div class="flex items-center justify-between text-xs gap-2">
              <div class="flex items-center gap-1.5 flex-1 min-w-0">
                <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span class="text-gray-600 truncate">{{ penjualan.user?.name || '-' }}</span>
              </div>
              <span
                class="text-xs px-2 py-0.5 rounded-full font-medium flex-shrink-0"
                :class="getPaymentMethodClass(penjualan.metode_pembayaran)"
              >
                {{ penjualan.metode_pembayaran }}
              </span>
            </div>

            <!-- Customer Name - Show icon if Member -->
            <div v-if="penjualan.nama_pelanggan || penjualan.buyer" class="flex items-center gap-1.5 text-xs">
              <svg class="w-3.5 h-3.5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              <span :class="penjualan.buyer ? 'text-indigo-600 font-medium' : 'text-gray-600'" class="truncate">
                {{ penjualan.buyer ? penjualan.buyer.name : penjualan.nama_pelanggan }}
              </span>
              <!-- Member Icon Badge -->
              <svg v-if="penjualan.buyer" class="w-4 h-4 text-indigo-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
              </svg>
            </div>

            <!-- Total - Prominent -->
            <div class="flex justify-between items-center text-sm font-bold pt-2 border-t border-gray-200">
              <span class="text-gray-900">Total</span>
              <span class="text-green-600">{{ formatCurrency(penjualan.total) }}</span>
            </div>

            <!-- Verification Info -->
            <div v-if="penjualan.is_verified || penjualan.is_approved || penjualan.is_recorded" class="text-xs bg-gray-50 rounded p-2 space-y-1">
              <div v-if="penjualan.is_verified" class="flex items-center gap-1.5 text-green-700">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Diverifikasi oleh {{ penjualan.verified_by?.name || '-' }}</span>
              </div>
              <div v-if="penjualan.is_approved" class="flex items-center gap-1.5 text-blue-700">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Approved by {{ penjualan.approved_by?.name || '-' }}</span>
              </div>
              <div v-if="penjualan.is_recorded" class="flex items-center gap-1.5 text-purple-700">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
                  <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm9.707 5.707a1 1 0 00-1.414-1.414L9 12.586l-1.293-1.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                <span>Recorded by {{ penjualan.recorded_by?.name || '-' }}</span>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex gap-2 pt-2 flex-wrap">
              <!-- Print Receipt Button - Kantin hanya bisa cetak transaksi sendiri -->
              <button
                v-if="canPrintReceipt(penjualan)"
                @click="printReceipt(penjualan)"
                class="px-3 py-1.5 text-xs bg-[#996600] text-white rounded hover:bg-[#7a5100] font-medium flex items-center gap-1.5"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                Cetak
              </button>

              <!-- Assign Member Button - Officer/Sysadmin untuk transaksi belum verified -->
              <button
                v-if="canBulkVerify && !penjualan.is_verified && !penjualan.buyer_id"
                @click="openAssignMemberModal(penjualan)"
                class="flex-1 px-3 py-1.5 text-xs bg-indigo-50 text-indigo-600 rounded hover:bg-indigo-100 font-medium"
              >
                Assign Member
              </button>

              <!-- Verify Button - Semua user bisa verifikasi transaksi mereka sendiri -->
              <button
                v-if="canVerify && !penjualan.is_verified && canVerifyTransaction(penjualan)"
                @click="openVerifyModal(penjualan.id)"
                class="flex-1 px-3 py-1.5 text-xs bg-green-50 text-green-600 rounded hover:bg-green-100 font-medium"
              >
                Verifikasi
              </button>

              <!-- Unverify Button - Officer/Sysadmin untuk koreksi -->
              <button
                v-if="canBulkVerify && penjualan.is_verified && !penjualan.is_approved && !penjualan.is_recorded"
                @click="unverifyTransaction(penjualan.id)"
                class="flex-1 px-3 py-1.5 text-xs bg-orange-50 text-orange-600 rounded hover:bg-orange-100 font-medium"
              >
                Unverify
              </button>

              <!-- Approve Button - Sysadmin only -->
              <button
                v-if="canApprove && penjualan.is_verified && !penjualan.is_approved"
                @click="approveSingle(penjualan.id)"
                class="flex-1 px-3 py-1.5 text-xs bg-blue-50 text-blue-600 rounded hover:bg-blue-100 font-medium"
              >
                Approve
              </button>

              <!-- Unapprove Button - Sysadmin only untuk koreksi -->
              <button
                v-if="canApprove && penjualan.is_approved && !penjualan.is_recorded"
                @click="unapproveTransaction(penjualan.id)"
                class="flex-1 px-3 py-1.5 text-xs bg-red-50 text-red-600 rounded hover:bg-red-100 font-medium"
              >
                Unapprove
              </button>

              <!-- Record Button - Officer/Sysadmin -->
              <button
                v-if="canBulkVerify && penjualan.is_approved && !penjualan.is_recorded"
                @click="recordSingle(penjualan.id)"
                class="flex-1 px-3 py-1.5 text-xs bg-purple-50 text-purple-600 rounded hover:bg-purple-100 font-medium"
              >
                Rekam
              </button>

              <!-- Cancel Button -->
              <button
                v-if="canCancel(penjualan)"
                @click="showCancelModal(penjualan)"
                class="flex-1 px-3 py-1.5 text-xs bg-red-50 text-red-600 rounded hover:bg-red-100 font-medium"
              >
                Batalkan
              </button>
            </div>
          </div>
          </div>
        </div>

        <!-- Empty State -->
        <div v-if="penjualans.data.length === 0" class="text-center py-12 col-span-full">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          <p class="text-gray-500 text-sm">Tidak ada transaksi</p>
          <p class="text-gray-400 text-xs mt-1">Coba ubah filter tanggal</p>
        </div>

        <!-- Load More / Pagination -->
        <div v-if="penjualans.data.length > 0 && (penjualans.next_page_url || penjualans.prev_page_url)" class="pt-2 pb-4">
          <div class="flex gap-2 justify-center">
            <Link
              v-if="penjualans.prev_page_url"
              :href="penjualans.prev_page_url"
              class="px-4 py-2 text-sm bg-white border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50"
            >
              ← Sebelumnya
            </Link>
            <Link
              v-if="penjualans.next_page_url"
              :href="penjualans.next_page_url"
              class="px-4 py-2 text-sm bg-[#996600] text-white rounded-lg hover:bg-[#7a5100]"
            >
              Selanjutnya →
            </Link>
          </div>
          <div class="text-center mt-2 text-xs text-gray-500">
            {{ penjualans.from }}-{{ penjualans.to }} dari {{ penjualans.total }}
          </div>
        </div>
      </div>

      <!-- Verify Single Confirmation Modal -->
      <div
        v-if="showVerifyModal"
        class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
        @click.self="closeVerifyModal"
      >
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full">
          <div class="bg-gradient-to-r from-[#996600] to-[#7a5100] text-white p-4 rounded-t-lg">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold">Verifikasi Transaksi</h3>
                <p class="text-sm text-[#eae0cc] mt-0.5">Konfirmasi bahwa data transaksi sudah benar</p>
              </div>
            </div>
          </div>

          <div class="p-4">
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 mb-4">
              <div class="flex gap-2">
                <svg class="w-5 h-5 text-yellow-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="text-sm text-yellow-800">
                  <p class="font-medium">Perhatian!</p>
                  <p class="text-xs mt-1">Setelah diverifikasi, transaksi tidak dapat diubah atau dibatalkan lagi.</p>
                </div>
              </div>
            </div>

            <p class="text-sm text-gray-700">
              Apakah Anda yakin data transaksi ini sudah benar dan siap diverifikasi?
            </p>
          </div>

          <div class="p-4 bg-gray-50 rounded-b-lg flex gap-2">
            <button
              @click="closeVerifyModal"
              class="flex-1 px-4 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-100 font-medium transition-colors"
            >
              Batal
            </button>
            <button
              @click="confirmVerify"
              class="flex-1 px-4 py-2.5 bg-[#996600] hover:bg-[#7a5100] text-white rounded-lg font-semibold transition-colors"
            >
              Ya, Verifikasi
            </button>
          </div>
        </div>
      </div>

      <!-- Verify All Modal -->
      <div
        v-if="showVerifyAllModal"
        class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
        @click.self="showVerifyAllModal = false"
      >
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full">
          <div class="bg-gradient-to-r from-[#996600] to-[#7a5100] text-white p-4 rounded-t-lg">
            <h3 class="text-lg font-bold">Verifikasi Semua Transaksi</h3>
          </div>
          <div class="p-4">
            <p class="text-sm text-gray-700 mb-4">
              Yakin ingin verifikasi semua transaksi yang belum diverifikasi di periode ini?
            </p>
            <div class="bg-[#eae0cc] rounded p-3 text-xs">
              <div class="flex justify-between mb-1">
                <span>Periode:</span>
                <span class="font-semibold">{{ filters.start_date }} s/d {{ filters.end_date }}</span>
              </div>
              <div v-if="filters.work_unit_id" class="flex justify-between">
                <span>Unit Kerja:</span>
                <span class="font-semibold">{{ getWorkUnitName(filters.work_unit_id) }}</span>
              </div>
            </div>
          </div>
          <div class="p-4 bg-gray-50 rounded-b-lg flex gap-2">
            <button
              @click="showVerifyAllModal = false"
              class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-100"
            >
              Batal
            </button>
            <button
              @click="verifyAll"
              class="flex-1 px-4 py-2 bg-[#996600] text-white rounded-lg hover:bg-[#7a5100] font-semibold"
            >
              Verifikasi Semua
            </button>
          </div>
        </div>
      </div>

      <!-- Detail Transaction Modal -->
      <div
        v-if="showDetailModal && detailPenjualan"
        class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
        @click.self="closeDetailModal"
      >
        <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
          <!-- Header -->
          <div class="bg-gradient-to-r from-[#6b4700] to-[#5b3d00] text-white p-4 sticky top-0 z-10">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-lg font-bold">Detail Transaksi</h3>
                <p class="text-sm text-[#c1a366]">{{ detailPenjualan.nomor_transaksi }}</p>
              </div>
              <button @click="closeDetailModal" class="p-2 hover:bg-white/20 rounded-full transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Content -->
          <div class="p-4">
            <!-- Info Transaksi -->
            <div class="bg-gray-50 rounded-lg p-4 mb-4">
              <h4 class="text-sm font-semibold text-gray-700 mb-3">Informasi Transaksi</h4>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between">
                  <span class="text-gray-600">Tanggal & Waktu:</span>
                  <span class="font-medium text-gray-900">{{ formatDateTime(detailPenjualan.tanggal_transaksi) }}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Unit Kerja:</span>
                  <span class="font-medium text-gray-900">{{ detailPenjualan.work_unit?.name || '-' }}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Kasir:</span>
                  <span class="font-medium text-gray-900">{{ detailPenjualan.user?.name || '-' }}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Metode Pembayaran:</span>
                  <span
                    class="px-2 py-0.5 rounded-full text-xs font-medium"
                    :class="getPaymentMethodClass(detailPenjualan.metode_pembayaran)"
                  >
                    {{ detailPenjualan.metode_pembayaran }}
                  </span>
                </div>
                <div v-if="detailPenjualan.nama_pelanggan" class="flex justify-between">
                  <span class="text-gray-600">Nama Pelanggan:</span>
                  <span class="font-medium text-gray-900">{{ detailPenjualan.nama_pelanggan }}</span>
                </div>
                <div v-if="detailPenjualan.buyer" class="flex justify-between">
                  <span class="text-gray-600">Member Buyer:</span>
                  <span class="font-medium text-indigo-700">{{ detailPenjualan.buyer.name }}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Status:</span>
                  <span
                    class="px-2 py-0.5 rounded-full text-xs font-medium"
                    :class="getStatusClass(detailPenjualan)"
                  >
                    {{ getStatusText(detailPenjualan) }}
                  </span>
                </div>
              </div>
            </div>

            <!-- Items List -->
            <div class="bg-gray-50 rounded-lg p-4 mb-4">
              <h4 class="text-sm font-semibold text-gray-700 mb-3">Item Terjual</h4>
              <div class="space-y-2">
                <div
                  v-for="(item, index) in detailPenjualan.items"
                  :key="index"
                  class="flex justify-between items-start bg-white rounded p-3"
                >
                  <div class="flex-1">
                    <div class="font-medium text-gray-900">{{ item.nama_barang }}</div>
                    <div class="text-xs text-gray-500">{{ item.qty }} {{ item.satuan }} × Rp {{ formatCurrency(item.harga_satuan) }}</div>
                    <div v-if="item.diskon_per_item > 0" class="text-xs text-red-600">
                      Diskon: -Rp {{ formatCurrency(item.diskon_per_item) }}
                    </div>
                  </div>
                  <div class="text-right">
                    <div class="font-semibold text-gray-900">Rp {{ formatCurrency(item.subtotal) }}</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Summary -->
            <div class="bg-gray-50 rounded-lg p-4 mb-4">
              <h4 class="text-sm font-semibold text-gray-700 mb-3">Ringkasan Pembayaran</h4>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between">
                  <span class="text-gray-600">Subtotal:</span>
                  <span class="font-medium text-gray-900">Rp {{ formatCurrency(detailPenjualan.subtotal) }}</span>
                </div>
                <div v-if="detailPenjualan.diskon > 0" class="flex justify-between text-red-600">
                  <span>Diskon:</span>
                  <span class="font-medium">-Rp {{ formatCurrency(detailPenjualan.diskon) }}</span>
                </div>
                <div class="flex justify-between text-lg font-bold border-t pt-2">
                  <span class="text-gray-900">Total:</span>
                  <span class="text-green-600">Rp {{ formatCurrency(detailPenjualan.total) }}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Bayar:</span>
                  <span class="font-medium text-gray-900">Rp {{ formatCurrency(detailPenjualan.bayar) }}</span>
                </div>
                <div v-if="detailPenjualan.kembalian > 0" class="flex justify-between text-green-600">
                  <span>Kembalian:</span>
                  <span class="font-semibold">Rp {{ formatCurrency(detailPenjualan.kembalian) }}</span>
                </div>
              </div>
            </div>

            <!-- Verification History -->
            <div v-if="detailPenjualan.is_verified || detailPenjualan.is_approved || detailPenjualan.is_recorded" class="bg-[#eae0cc] rounded-lg p-4 mb-4">
              <h4 class="text-sm font-semibold text-gray-700 mb-3">Riwayat Verifikasi</h4>
              <div class="space-y-2 text-sm">
                <div v-if="detailPenjualan.is_verified" class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <div>
                    <div class="font-medium text-green-700">Verified</div>
                    <div class="text-xs text-gray-600">{{ detailPenjualan.verified_by?.name || '-' }}</div>
                    <div class="text-xs text-gray-500">{{ formatDateTime(detailPenjualan.verified_at) }}</div>
                  </div>
                </div>
                <div v-if="detailPenjualan.is_approved" class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-blue-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <div>
                    <div class="font-medium text-blue-700">Approved</div>
                    <div class="text-xs text-gray-600">{{ detailPenjualan.approved_by?.name || '-' }}</div>
                    <div class="text-xs text-gray-500">{{ formatDateTime(detailPenjualan.approved_at) }}</div>
                  </div>
                </div>
                <div v-if="detailPenjualan.is_recorded" class="flex items-start gap-2">
                  <svg class="w-5 h-5 text-purple-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" />
                    <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm9.707 5.707a1 1 0 00-1.414-1.414L9 12.586l-1.293-1.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <div>
                    <div class="font-medium text-purple-700">Recorded to Buku Kas</div>
                    <div class="text-xs text-gray-600">{{ detailPenjualan.recorded_by?.name || '-' }}</div>
                    <div class="text-xs text-gray-500">{{ formatDateTime(detailPenjualan.recorded_at) }}</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Catatan -->
            <div v-if="detailPenjualan.catatan" class="bg-yellow-50 rounded-lg p-4">
              <h4 class="text-sm font-semibold text-gray-700 mb-2">Catatan</h4>
              <p class="text-sm text-gray-600">{{ detailPenjualan.catatan }}</p>
            </div>
          </div>

          <!-- Footer -->
          <div class="p-4 bg-gray-50 border-t space-y-2">
            <!-- Print Button - Prominent -->
            <button
              v-if="canPrintReceipt(detailPenjualan)"
              @click="printReceipt(detailPenjualan)"
              class="w-full px-4 py-2.5 bg-[#996600] hover:bg-[#7a5100] text-white rounded-lg font-semibold transition-colors flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
              </svg>
              Cetak Struk
            </button>

            <!-- Close Button -->
            <button
              @click="closeDetailModal"
              class="w-full px-4 py-2.5 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-lg font-semibold transition-colors"
            >
              Tutup
            </button>
          </div>
        </div>
      </div>

      <!-- Cancel Confirmation Modal -->
      <div
        v-if="showCancelConfirmModal"
        class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
        @click.self="closeCancelModal"
      >
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full">
          <!-- Header -->
          <div class="bg-red-500 text-white p-4 rounded-t-lg">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold">Batalkan Transaksi</h3>
                <p class="text-sm text-red-100 mt-0.5">Tindakan ini akan mengembalikan stok barang</p>
              </div>
            </div>
          </div>

          <!-- Content -->
          <div class="p-4">
            <div v-if="selectedPenjualan" class="bg-gray-50 rounded-lg p-3 mb-4">
              <div class="text-xs text-gray-500 mb-1">No. Transaksi</div>
              <div class="font-mono text-sm font-bold text-gray-900 mb-2">{{ selectedPenjualan.nomor_transaksi }}</div>
              <div class="text-xs text-gray-600">
                {{ formatDateTime(selectedPenjualan.tanggal_transaksi) }}
              </div>
              <div class="mt-2 pt-2 border-t border-gray-200">
                <div class="flex justify-between text-sm">
                  <span class="text-gray-600">Total Transaksi</span>
                  <span class="font-bold text-gray-900">{{ formatCurrency(selectedPenjualan.total) }}</span>
                </div>
              </div>
            </div>

            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 mb-4">
              <div class="flex gap-2">
                <svg class="w-5 h-5 text-yellow-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="text-sm text-yellow-800">
                  <p class="font-medium">Perhatian!</p>
                  <p class="text-xs mt-1">Stok barang akan dikembalikan ke inventory. Pastikan tindakan ini sudah benar.</p>
                </div>
              </div>
            </div>

            <p class="text-sm text-gray-700">
              Apakah Anda yakin ingin membatalkan transaksi ini?
            </p>
          </div>

          <!-- Actions -->
          <div class="p-4 bg-gray-50 rounded-b-lg flex gap-2">
            <button
              @click="closeCancelModal"
              class="flex-1 px-4 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-100 font-medium transition-colors"
            >
              Tidak, Kembali
            </button>
            <button
              @click="confirmCancel"
              class="flex-1 px-4 py-2.5 bg-red-500 hover:bg-red-600 text-white rounded-lg font-semibold transition-colors"
            >
              Ya, Batalkan
            </button>
          </div>
        </div>
      </div>

      <!-- Assign Member Modal -->
      <div
        v-if="showAssignMemberModal && selectedPenjualan"
        class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
        @click.self="closeAssignMemberModal"
      >
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full">
          <!-- Header -->
          <div class="bg-gradient-to-r from-indigo-600 to-indigo-700 text-white p-4 rounded-t-lg">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-bold">Assign Member Buyer</h3>
                <p class="text-sm text-indigo-100 mt-0.5">Tetapkan transaksi ke member</p>
              </div>
            </div>
          </div>

          <!-- Content -->
          <div class="p-4">
            <div class="bg-gray-50 rounded-lg p-3 mb-4">
              <div class="text-xs text-gray-500 mb-1">No. Transaksi</div>
              <div class="font-mono text-sm font-bold text-gray-900">{{ selectedPenjualan.nomor_transaksi }}</div>
              <div class="text-xs text-gray-600 mt-1">
                {{ formatDateTime(selectedPenjualan.tanggal_transaksi) }}
              </div>
              <div class="mt-2 pt-2 border-t border-gray-200">
                <div class="flex justify-between text-sm">
                  <span class="text-gray-600">Total</span>
                  <span class="font-bold text-gray-900">{{ formatCurrency(selectedPenjualan.total) }}</span>
                </div>
              </div>
            </div>

            <!-- Search Member -->
            <div class="mb-3">
              <label class="block text-xs font-medium text-gray-700 mb-1">Cari Member</label>
              <input
                v-model="buyerSearch"
                type="text"
                placeholder="Ketik nama atau kode member..."
                class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500"
                @input="searchBuyers"
              />
            </div>

            <!-- Buyer List -->
            <div class="mb-4 max-h-64 overflow-y-auto space-y-1">
              <div v-if="filteredBuyers.length === 0" class="text-center py-8">
                <svg class="w-12 h-12 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                </svg>
                <p class="text-sm text-gray-500">Tidak ada member ditemukan</p>
              </div>
              <div
                v-for="buyer in filteredBuyers"
                :key="buyer.id"
                @click="selectBuyer(buyer)"
                class="p-3 border rounded-lg cursor-pointer transition-colors hover:bg-indigo-50"
                :class="selectedBuyerId === buyer.id ? 'border-indigo-500 bg-indigo-50' : 'border-gray-200'"
              >
                <div class="flex items-center justify-between">
                  <div class="flex-1">
                    <div class="font-medium text-sm text-gray-900">{{ buyer.name }}</div>
                    <div class="text-xs text-gray-500">{{ buyer.member_code }}</div>
                    <div v-if="buyer.membership_tier" class="text-xs text-indigo-600 mt-0.5">
                      {{ buyer.membership_tier.name }}
                    </div>
                  </div>
                  <div v-if="selectedBuyerId === buyer.id" class="flex-shrink-0">
                    <svg class="w-5 h-5 text-indigo-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="p-4 bg-gray-50 rounded-b-lg flex gap-2">
            <button
              @click="closeAssignMemberModal"
              class="flex-1 px-4 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-100 font-medium transition-colors"
            >
              Batal
            </button>
            <button
              @click="confirmAssignMember"
              :disabled="!selectedBuyerId"
              class="flex-1 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Assign Member
            </button>
          </div>
        </div>
      </div>

      <!-- Item Summary Modal -->
      <div
        v-if="showItemSummaryModal"
        class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
        @click.self="closeItemSummaryModal"
      >
        <div class="bg-white rounded-lg shadow-xl max-w-4xl w-full max-h-[90vh] overflow-hidden flex flex-col">
          <!-- Header -->
          <div class="bg-gradient-to-r from-[#996600] to-[#7a5100] text-white p-4 sticky top-0 z-10">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-lg font-bold">Ringkasan Item</h3>
                <p class="text-sm text-[#eae0cc]">{{ getCurrentDateRange() }}</p>
              </div>
              <button @click="closeItemSummaryModal" class="p-2 hover:bg-white/20 rounded-full transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Content -->
          <div class="flex-1 overflow-y-auto p-4">
            <!-- Mobile: Card Layout -->
            <div v-if="paginatedItemSummary.length > 0" class="lg:hidden space-y-3">
              <div
                v-for="(item, index) in paginatedItemSummary"
                :key="index"
                class="bg-gray-50 rounded-lg border border-gray-200 overflow-hidden"
              >
                <div class="p-3">
                  <div class="flex justify-between items-start mb-2">
                    <div class="flex-1 pr-2">
                      <div class="text-xs text-gray-500 mb-0.5">{{ itemSummaryFrom + index }}</div>
                      <div class="font-semibold text-gray-900 text-sm">{{ item.nama_barang }}</div>
                      <div class="text-xs text-gray-600 mt-0.5">{{ item.satuan }}</div>
                    </div>
                    <div class="text-right">
                      <div class="text-sm font-bold text-gray-900">{{ item.total_qty }}x</div>
                    </div>
                  </div>
                  <div class="flex justify-between items-center pt-2 border-t border-gray-300 mb-2">
                    <span class="text-xs text-gray-600">Total Harga</span>
                    <span class="text-sm font-bold text-green-600">{{ formatCurrency(item.total_harga) }}</span>
                  </div>

                  <!-- Expandable Detail Stock Reduction -->
                  <button
                    v-if="item.stock_reductions && item.stock_reductions.length > 0"
                    @click="toggleStockDetail(index)"
                    class="w-full text-xs text-[#996600] hover:text-[#7a5100] font-medium flex items-center justify-center gap-1 py-1"
                  >
                    <svg
                      :class="['w-3 h-3 transition-transform', expandedStockDetails.includes(index) ? 'rotate-90' : '']"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                    <span>Detail Pengurangan ({{ item.stock_reductions.length }} transaksi)</span>
                  </button>
                </div>

                <!-- Stock Reduction Details -->
                <transition name="expand">
                  <div v-show="expandedStockDetails.includes(index)" class="border-t border-gray-300 bg-white">
                    <div class="p-2 space-y-1.5 max-h-48 overflow-y-auto">
                      <div
                        v-for="(reduction, rIdx) in item.stock_reductions"
                        :key="rIdx"
                        class="text-xs bg-gray-50 rounded p-2 border border-gray-200"
                      >
                        <div class="flex justify-between items-start mb-1">
                          <span class="font-mono text-[#996600] font-medium text-[10px]">{{ reduction.nomor_transaksi }}</span>
                          <span class="text-gray-500 text-[10px]">{{ formatDateTime(reduction.tanggal_transaksi) }}</span>
                        </div>
                        <div class="flex justify-between items-center">
                          <span class="text-gray-700">{{ reduction.qty }}x @ {{ formatCurrency(reduction.harga_satuan) }}</span>
                          <span class="font-semibold text-green-600">{{ formatCurrency(reduction.subtotal) }}</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </transition>
              </div>

              <!-- Total Summary Card -->
              <div class="bg-[#996600] rounded-lg p-3 text-white font-bold sticky bottom-0">
                <div class="flex justify-between items-center">
                  <span class="text-sm">TOTAL KESELURUHAN</span>
                  <span class="text-lg">{{ formatCurrency(calculateTotalHarga()) }}</span>
                </div>
              </div>
            </div>

            <!-- Desktop: Table Layout -->
            <div v-if="paginatedItemSummary.length > 0" class="hidden lg:block overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-12"></th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">No</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nama Barang</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Satuan</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total Kuantitas</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Total Harga</th>
                  </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                  <template v-for="(item, index) in paginatedItemSummary" :key="index">
                    <!-- Main Row -->
                    <tr class="hover:bg-gray-50">
                      <td class="px-4 py-3 text-center">
                        <button
                          v-if="item.stock_reductions && item.stock_reductions.length > 0"
                          @click="toggleStockDetail(index)"
                          class="text-[#996600] hover:text-[#7a5100] transition-transform"
                        >
                          <svg
                            :class="['w-4 h-4', expandedStockDetails.includes(index) ? 'rotate-90' : '']"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                          </svg>
                        </button>
                      </td>
                      <td class="px-4 py-3 text-sm text-gray-900">{{ itemSummaryFrom + index }}</td>
                      <td class="px-4 py-3 text-sm text-gray-900 font-medium">{{ item.nama_barang }}</td>
                      <td class="px-4 py-3 text-sm text-gray-600">{{ item.satuan }}</td>
                      <td class="px-4 py-3 text-sm text-gray-900 text-right">{{ item.total_qty }}</td>
                      <td class="px-4 py-3 text-sm text-green-600 font-semibold text-right">{{ formatCurrency(item.total_harga) }}</td>
                    </tr>

                    <!-- Expandable Detail Row -->
                    <tr v-show="expandedStockDetails.includes(index)">
                      <td colspan="6" class="px-4 py-2 bg-gray-50">
                        <div class="max-h-64 overflow-y-auto">
                          <table class="min-w-full text-xs">
                            <thead class="bg-white sticky top-0">
                              <tr>
                                <th class="px-3 py-2 text-left text-gray-600 font-medium">No. Transaksi</th>
                                <th class="px-3 py-2 text-left text-gray-600 font-medium">Tanggal</th>
                                <th class="px-3 py-2 text-right text-gray-600 font-medium">Qty</th>
                                <th class="px-3 py-2 text-right text-gray-600 font-medium">Harga Satuan</th>
                                <th class="px-3 py-2 text-right text-gray-600 font-medium">Subtotal</th>
                              </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                              <tr
                                v-for="(reduction, rIdx) in item.stock_reductions"
                                :key="rIdx"
                                class="hover:bg-gray-100"
                              >
                                <td class="px-3 py-2 font-mono text-[#996600]">{{ reduction.nomor_transaksi }}</td>
                                <td class="px-3 py-2 text-gray-600">{{ formatDateTime(reduction.tanggal_transaksi) }}</td>
                                <td class="px-3 py-2 text-right text-gray-900">{{ reduction.qty }}</td>
                                <td class="px-3 py-2 text-right text-gray-700">{{ formatCurrency(reduction.harga_satuan) }}</td>
                                <td class="px-3 py-2 text-right text-green-600 font-semibold">{{ formatCurrency(reduction.subtotal) }}</td>
                              </tr>
                            </tbody>
                          </table>
                        </div>
                      </td>
                    </tr>
                  </template>
                </tbody>
                <tfoot class="bg-gray-50">
                  <tr>
                    <td colspan="5" class="px-4 py-3 text-sm font-bold text-gray-900 text-right">TOTAL:</td>
                    <td class="px-4 py-3 text-sm font-bold text-green-600 text-right">
                      {{ formatCurrency(calculateTotalHarga()) }}
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>

            <!-- Pagination -->
            <div v-if="paginatedItemSummary.length > 0 && totalPages > 1" class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-2">
              <button
                @click="goToPage(itemSummaryPage - 1)"
                :disabled="itemSummaryPage === 1"
                class="w-full sm:w-auto px-4 py-2 text-sm bg-white border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                ← Sebelumnya
              </button>
              <span class="text-sm text-gray-600 text-center">
                Halaman {{ itemSummaryPage }} dari {{ totalPages }}<br class="sm:hidden">
                <span class="text-xs">({{ itemSummaryFrom }}-{{ itemSummaryTo }} dari {{ itemSummary.length }})</span>
              </span>
              <button
                @click="goToPage(itemSummaryPage + 1)"
                :disabled="itemSummaryPage === totalPages"
                class="w-full sm:w-auto px-4 py-2 text-sm bg-white border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                Selanjutnya →
              </button>
            </div>

            <!-- Empty State -->
            <div v-if="!paginatedItemSummary.length" class="text-center py-12">
              <svg class="w-16 h-16 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
              </svg>
              <p class="text-gray-500 text-sm">Tidak ada item dalam periode ini</p>
            </div>
          </div>

          <!-- Footer -->
          <div class="p-4 bg-gray-50 border-t flex flex-col sm:flex-row gap-2">
            <!-- Print Item Summary Button -->
            <button
              @click="printItemSummary"
              :disabled="!itemSummary || itemSummary.length === 0"
              class="flex-1 px-4 py-2.5 bg-[#996600] hover:bg-[#7a5100] text-white rounded-lg font-semibold transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
              </svg>
              Cetak Ringkasan
            </button>
            <!-- Download CSV Button -->
            <button
              @click="downloadCSV"
              :disabled="!itemSummary || itemSummary.length === 0"
              class="flex-1 px-4 py-2.5 bg-green-600 hover:bg-green-700 text-white rounded-lg font-semibold transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Unduh CSV
            </button>
            <!-- Close Button -->
            <button
              @click="closeItemSummaryModal"
              class="flex-1 px-4 py-2.5 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-100 font-medium transition-colors"
            >
              Tutup
            </button>
          </div>
        </div>
      </div>
    </div>
  </component>
</template>

<script setup>
import { ref, computed } from 'vue'
import { router, usePage, Link } from '@inertiajs/vue3'
import AdminLayout from '@/Layouts/AdminLayout.vue'
import CanteenLayout from '@/Layouts/CanteenLayout.vue'
import { useToast } from 'vue-toastification'
import { useThermalPrinter } from '@/composables/useThermalPrinter'

const toast = useToast()
const { printReceipt: printThermalReceipt } = useThermalPrinter()

const props = defineProps({
  workUnits: Array,
  selectedWorkUnitId: Number,
  startDate: String,
  endDate: String,
  penjualans: Object,
  summary: Object,
  itemSummary: Array,
  buyers: Array,
})

const page = usePage()

// Pilih layout berdasarkan role user
const layoutComponent = computed(() => {
  const user = page.props.auth?.user
  if (user?.roles?.includes('canteen') && !user?.roles?.includes('officer') && !user?.roles?.includes('sysadmin')) {
    return CanteenLayout
  }
  return AdminLayout
})

// Check if user is kantin only
const isKantinUser = computed(() => {
  const user = page.props.auth?.user
  return user?.roles?.includes('canteen') && !user?.roles?.includes('officer') && !user?.roles?.includes('sysadmin')
})

// Check permissions
const canVerify = computed(() => {
  const user = page.props.auth?.user
  // Kantin bisa verifikasi transaksi sendiri, Officer/Sysadmin bisa verifikasi semua
  return user?.roles?.includes('canteen') || user?.roles?.includes('officer') || user?.roles?.includes('sysadmin')
})

const canBulkVerify = computed(() => {
  const user = page.props.auth?.user
  // Hanya Officer/Sysadmin yang bisa bulk verify
  return user?.roles?.includes('officer') || user?.roles?.includes('sysadmin')
})

const canPrintReceipt = (penjualan) => {
  const user = page.props.auth?.user
  // Officer/Sysadmin bisa print semua transaksi
  if (user?.roles?.includes('officer') || user?.roles?.includes('sysadmin')) {
    return true
  }
  // Kantin hanya bisa print transaksi sendiri
  if (user?.roles?.includes('canteen')) {
    return penjualan.user_id === user.id
  }
  return false
}

const canApprove = computed(() => {
  const user = page.props.auth?.user
  // Officer dan Sysadmin bisa approve
  return user?.roles?.includes('officer') || user?.roles?.includes('sysadmin')
})

const filters = ref({
  work_unit_id: props.selectedWorkUnitId,
  start_date: props.startDate,
  end_date: props.endDate,
  date: props.startDate, // For kantin user - single date view
})

const showCancelConfirmModal = ref(false)
const selectedPenjualan = ref(null)
const selectedTransactions = ref([])
const selectedForApproval = ref([])
const showVerifyAllModal = ref(false)
const showVerifyModal = ref(false)
const verifyingId = ref(null)
const showDetailModal = ref(false)
const detailPenjualan = ref(null)
const showItemSummaryModal = ref(false)
const itemSummaryPage = ref(1)
const itemsPerPage = 20
const expandedStockDetails = ref([]) // Track which items have expanded stock details
const showAssignMemberModal = ref(false)
const buyerSearch = ref('')
const filteredBuyers = ref([])
const selectedBuyerId = ref(null)

const applyFilters = () => {
  // For kantin user, use single date for both start and end
  const params = isKantinUser.value
    ? {
        work_unit_id: filters.value.work_unit_id,
        start_date: filters.value.date,
        end_date: filters.value.date,
      }
    : filters.value

  router.get('/pengelola/rekap-penjualan', params, {
    preserveState: true,
    preserveScroll: true,
  })
}

const setToday = () => {
  const today = new Date().toISOString().split('T')[0]
  if (isKantinUser.value) {
    filters.value.date = today
  } else {
    filters.value.start_date = today
    filters.value.end_date = today
  }
  applyFilters()
}

const setThisWeek = () => {
  const now = new Date()
  const startOfWeek = new Date(now)
  startOfWeek.setDate(now.getDate() - now.getDay()) // Sunday
  const endOfWeek = new Date(startOfWeek)
  endOfWeek.setDate(startOfWeek.getDate() + 6) // Saturday

  filters.value.start_date = startOfWeek.toISOString().split('T')[0]
  filters.value.end_date = endOfWeek.toISOString().split('T')[0]
  applyFilters()
}

const setThisMonth = () => {
  const now = new Date()
  const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1)
  const endOfMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0)

  filters.value.start_date = startOfMonth.toISOString().split('T')[0]
  filters.value.end_date = endOfMonth.toISOString().split('T')[0]
  applyFilters()
}

// Computed untuk menandai tombol aktif
const isToday = computed(() => {
  const today = new Date().toISOString().split('T')[0]
  return filters.value.start_date === today && filters.value.end_date === today
})

const isThisWeek = computed(() => {
  const now = new Date()
  const startOfWeek = new Date(now)
  startOfWeek.setDate(now.getDate() - now.getDay())
  const endOfWeek = new Date(startOfWeek)
  endOfWeek.setDate(startOfWeek.getDate() + 6)

  const start = startOfWeek.toISOString().split('T')[0]
  const end = endOfWeek.toISOString().split('T')[0]

  return filters.value.start_date === start && filters.value.end_date === end
})

const isThisMonth = computed(() => {
  const now = new Date()
  const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1)
  const endOfMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0)

  const start = startOfMonth.toISOString().split('T')[0]
  const end = endOfMonth.toISOString().split('T')[0]

  return filters.value.start_date === start && filters.value.end_date === end
})

const resetFilters = () => {
  const today = new Date().toISOString().split('T')[0]

  if (isKantinUser.value) {
    filters.value = {
      work_unit_id: props.workUnits.length === 1 ? props.workUnits[0].id : null,
      date: today,
    }
  } else {
    filters.value = {
      work_unit_id: props.workUnits.length === 1 ? props.workUnits[0].id : null,
      start_date: today,
      end_date: today,
    }
  }

  applyFilters()
}

const formatCurrency = (value) => {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(value || 0)
}

const formatDateTime = (dateString) => {
  const date = new Date(dateString)
  return new Intl.DateTimeFormat('id-ID', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  }).format(date)
}

const getPaymentMethodClass = (method) => {
  const classes = {
    tunai: 'bg-green-100 text-green-800',
    transfer: 'bg-blue-100 text-blue-800',
    qris: 'bg-purple-100 text-purple-800',
    debit: 'bg-yellow-100 text-yellow-800',
    kredit: 'bg-red-100 text-red-800',
  }
  return classes[method] || 'bg-gray-100 text-gray-800'
}

const getStatusClass = (penjualan) => {
  if (penjualan.is_recorded) return 'bg-purple-100 text-purple-800'
  if (penjualan.is_approved) return 'bg-blue-100 text-blue-800'
  if (penjualan.is_verified) return 'bg-green-100 text-green-800'
  return 'bg-yellow-100 text-yellow-800'
}

const getStatusText = (penjualan) => {
  if (penjualan.is_recorded) return 'Tercatat'
  if (penjualan.is_approved) return 'Approved'
  if (penjualan.is_verified) return 'Verified'
  return 'Entry'
}

const getItemsText = (items) => {
  if (!items || items.length === 0) return '-'

  return items.map(item => {
    const name = item.nama_barang || item.barang?.nama_barang || 'Item'
    const qty = item.qty
    return `${name} (${qty}x)`
  }).join(', ')
}

const canCancel = (penjualan) => {
  const user = page.props.auth?.user

  // Only allow cancel if status is not cancelled and within 24 hours
  if (penjualan.status === 'dibatalkan') return false

  // Tidak bisa dibatalkan jika sudah diverifikasi
  if (penjualan.is_verified) return false

  // Hanya user pembuat transaksi yang bisa membatalkan
  if (penjualan.user_id !== user?.id) return false

  const transactionDate = new Date(penjualan.created_at || penjualan.tanggal_transaksi)
  const hoursSinceTransaction = (Date.now() - transactionDate.getTime()) / (1000 * 60 * 60)

  return hoursSinceTransaction <= 24
}

const canVerifyTransaction = (penjualan) => {
  const user = page.props.auth?.user

  // Officer dan Sysadmin bisa verifikasi semua transaksi
  if (user?.roles?.includes('officer') || user?.roles?.includes('sysadmin')) {
    return true
  }

  // User kantin hanya bisa verifikasi transaksi mereka sendiri
  if (user?.roles?.includes('canteen')) {
    return penjualan.user_id === user.id
  }

  return false
}

const showCancelModal = (penjualan) => {
  selectedPenjualan.value = penjualan
  showCancelConfirmModal.value = true
}

const closeCancelModal = () => {
  showCancelConfirmModal.value = false
  selectedPenjualan.value = null
}

const confirmCancel = () => {
  if (!selectedPenjualan.value) return

  router.post(`/pengelola/penjualan/${selectedPenjualan.value.id}/cancel`, {}, {
    preserveState: true,
    preserveScroll: true,
    onSuccess: () => {
      closeCancelModal()
      router.reload({ only: ['penjualans', 'summary'] })
      toast.success('Transaksi berhasil dibatalkan')
    },
    onError: (errors) => {
      closeCancelModal()
      toast.error(errors.error || 'Gagal membatalkan transaksi')
    }
  })
}

// Selection functions for Verification
const toggleSelection = (id) => {
  const index = selectedTransactions.value.indexOf(id)
  if (index >= 0) {
    selectedTransactions.value.splice(index, 1)
  } else {
    selectedTransactions.value.push(id)
  }
}

const clearSelection = () => {
  selectedTransactions.value = []
}

// Selection functions for Approval
const toggleApprovalSelection = (id) => {
  const index = selectedForApproval.value.indexOf(id)
  if (index >= 0) {
    selectedForApproval.value.splice(index, 1)
  } else {
    selectedForApproval.value.push(id)
  }
}

const clearApprovalSelection = () => {
  selectedForApproval.value = []
}

// Verification functions
const openVerifyModal = (id) => {
  verifyingId.value = id
  showVerifyModal.value = true
}

const closeVerifyModal = () => {
  showVerifyModal.value = false
  verifyingId.value = null
}

const confirmVerify = () => {
  if (!verifyingId.value) return

  router.post(`/pengelola/penjualan/${verifyingId.value}/verify`, {}, {
    preserveState: true,
    preserveScroll: true,
    onSuccess: () => {
      closeVerifyModal()
      router.reload({ only: ['penjualans', 'summary'] })
      toast.success('Transaksi berhasil diverifikasi')
    },
    onError: (errors) => {
      closeVerifyModal()
      toast.error(errors.error || 'Gagal verifikasi transaksi')
    }
  })
}

const verifySelected = () => {
  if (selectedTransactions.value.length === 0) return

  router.post('/pengelola/penjualan/verify-bulk', {
    transaction_ids: selectedTransactions.value
  }, {
    preserveState: true,
    preserveScroll: true,
    onSuccess: () => {
      clearSelection()
      router.reload({ only: ['penjualans', 'summary'] })
      toast.success('Transaksi berhasil diverifikasi')
    },
    onError: (errors) => {
      toast.error(errors.error || 'Gagal verifikasi transaksi')
    }
  })
}

const verifyAll = () => {
  router.post('/pengelola/penjualan/verify-all', {
    work_unit_id: filters.value.work_unit_id,
    start_date: filters.value.start_date,
    end_date: filters.value.end_date,
  }, {
    preserveState: true,
    preserveScroll: true,
    onSuccess: () => {
      showVerifyAllModal.value = false
      router.reload({ only: ['penjualans', 'summary'] })
      toast.success('Semua transaksi berhasil diverifikasi')
    },
    onError: (errors) => {
      showVerifyAllModal.value = false
      toast.error(errors.error || 'Gagal verifikasi transaksi')
    }
  })
}

const approveSingle = (id) => {
  router.post(`/pengelola/penjualan/${id}/approve`, {}, {
    preserveState: true,
    preserveScroll: true,
    onSuccess: () => {
      router.reload({ only: ['penjualans', 'summary'] })
      toast.success('Transaksi berhasil diapprove')
    },
    onError: (errors) => {
      toast.error(errors.error || 'Gagal approve transaksi')
    }
  })
}

const approveSelected = () => {
  if (selectedForApproval.value.length === 0) return

  router.post('/pengelola/penjualan/approve-bulk', {
    transaction_ids: selectedForApproval.value
  }, {
    preserveState: true,
    preserveScroll: true,
    onSuccess: () => {
      clearApprovalSelection()
      router.reload({ only: ['penjualans', 'summary'] })
      toast.success('Transaksi berhasil diapprove')
    },
    onError: (errors) => {
      toast.error(errors.error || 'Gagal approve transaksi')
    }
  })
}

// Unverify function for correction
const unverifyTransaction = (id) => {
  if (!confirm('Yakin ingin unverify transaksi ini? Transaksi akan dikembalikan ke status entry untuk koreksi.')) {
    return
  }

  router.post(`/pengelola/penjualan/${id}/unverify`, {}, {
    preserveState: true,
    preserveScroll: true,
    onSuccess: () => {
      router.reload({ only: ['penjualans', 'summary'] })
      toast.success('Transaksi berhasil di-unverify')
    },
    onError: (errors) => {
      toast.error(errors.error || 'Gagal unverify transaksi')
    }
  })
}

// Unapprove function for correction
const unapproveTransaction = (id) => {
  if (!confirm('Yakin ingin unapprove transaksi ini? Poin member (jika ada) akan di-reverse dan transaksi dikembalikan ke status verified untuk koreksi.')) {
    return
  }

  router.post(`/pengelola/penjualan/${id}/unapprove`, {}, {
    preserveState: true,
    preserveScroll: true,
    onSuccess: () => {
      router.reload({ only: ['penjualans', 'summary'] })
      toast.success('Transaksi berhasil di-unapprove dan poin telah di-reverse')
    },
    onError: (errors) => {
      toast.error(errors.error || 'Gagal unapprove transaksi')
    }
  })
}

const recordSingle = (id) => {
  router.post(`/pengelola/penjualan/${id}/record`, {}, {
    preserveState: true,
    preserveScroll: true,
    onSuccess: () => {
      router.reload({ only: ['penjualans', 'summary'] })
      toast.success('Transaksi berhasil direkam ke buku kas')
    },
    onError: (errors) => {
      toast.error(errors.error || 'Gagal rekam transaksi')
    }
  })
}

const getWorkUnitName = (id) => {
  const unit = props.workUnits.find(u => u.id === id)
  return unit?.name || 'Semua Unit'
}

const openDetailModal = (penjualan) => {
  detailPenjualan.value = penjualan
  showDetailModal.value = true
}

const closeDetailModal = () => {
  showDetailModal.value = false
  detailPenjualan.value = null
}

// Computed for paginated item summary
const paginatedItemSummary = computed(() => {
  if (!props.itemSummary) return []
  const start = (itemSummaryPage.value - 1) * itemsPerPage
  const end = start + itemsPerPage
  return props.itemSummary.slice(start, end)
})

const totalPages = computed(() => {
  if (!props.itemSummary) return 0
  return Math.ceil(props.itemSummary.length / itemsPerPage)
})

const itemSummaryFrom = computed(() => {
  if (!props.itemSummary || props.itemSummary.length === 0) return 0
  return (itemSummaryPage.value - 1) * itemsPerPage + 1
})

const itemSummaryTo = computed(() => {
  if (!props.itemSummary) return 0
  const to = itemSummaryPage.value * itemsPerPage
  return Math.min(to, props.itemSummary.length)
})

// Item Summary Modal functions
const openItemSummaryModal = () => {
  showItemSummaryModal.value = true
  itemSummaryPage.value = 1
}

const closeItemSummaryModal = () => {
  showItemSummaryModal.value = false
  itemSummaryPage.value = 1
  expandedStockDetails.value = [] // Reset expanded details when closing modal
}

const goToPage = (page) => {
  if (page >= 1 && page <= totalPages.value) {
    itemSummaryPage.value = page
  }
}

const toggleStockDetail = (index) => {
  const idx = expandedStockDetails.value.indexOf(index)
  if (idx > -1) {
    expandedStockDetails.value.splice(idx, 1)
  } else {
    expandedStockDetails.value.push(index)
  }
}

const calculateTotalHarga = () => {
  if (!props.itemSummary) return 0
  return props.itemSummary.reduce((sum, item) => sum + parseFloat(item.total_harga), 0)
}

const getCurrentDateRange = () => {
  if (isKantinUser.value) {
    // Kantin user menggunakan single date
    const date = filters.value.date || props.startDate
    return formatDateIndo(date)
  } else {
    // Admin/Officer menggunakan date range
    const start = filters.value.start_date || props.startDate
    const end = filters.value.end_date || props.endDate

    if (start === end) {
      return formatDateIndo(start)
    }
    return `${formatDateIndo(start)} s/d ${formatDateIndo(end)}`
  }
}

const formatDateIndo = (dateString) => {
  if (!dateString) return '-'

  const date = new Date(dateString)
  return new Intl.DateTimeFormat('id-ID', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  }).format(date)
}

const downloadCSV = () => {
  const params = new URLSearchParams({
    start_date: isKantinUser.value ? filters.value.date : filters.value.start_date,
    end_date: isKantinUser.value ? filters.value.date : filters.value.end_date,
  })

  if (filters.value.work_unit_id) {
    params.append('work_unit_id', filters.value.work_unit_id)
  }

  window.location.href = `/pengelola/rekap-penjualan/export-item-summary?${params.toString()}`
  toast.success('File CSV sedang diunduh')
}

// Assign Member functions
const openAssignMemberModal = (penjualan) => {
  selectedPenjualan.value = penjualan
  selectedBuyerId.value = penjualan.buyer_id
  buyerSearch.value = ''
  filteredBuyers.value = props.buyers || []
  showAssignMemberModal.value = true
}

const closeAssignMemberModal = () => {
  showAssignMemberModal.value = false
  selectedPenjualan.value = null
  selectedBuyerId.value = null
  buyerSearch.value = ''
  filteredBuyers.value = []
}

const searchBuyers = () => {
  const search = buyerSearch.value.toLowerCase().trim()

  if (!search) {
    filteredBuyers.value = props.buyers || []
    return
  }

  filteredBuyers.value = (props.buyers || []).filter(buyer => {
    return buyer.name.toLowerCase().includes(search) ||
           buyer.member_code.toLowerCase().includes(search)
  })
}

const selectBuyer = (buyer) => {
  selectedBuyerId.value = buyer.id
}

const confirmAssignMember = () => {
  if (!selectedPenjualan.value || !selectedBuyerId.value) return

  router.post(`/pengelola/penjualan/${selectedPenjualan.value.id}/assign-member`, {
    buyer_id: selectedBuyerId.value
  }, {
    preserveState: true,
    preserveScroll: true,
    onSuccess: () => {
      closeAssignMemberModal()
      router.reload({ only: ['penjualans'] })
      toast.success('Member berhasil di-assign ke transaksi')
    },
    onError: (errors) => {
      toast.error(errors.error || 'Gagal assign member')
    }
  })
}

// Print receipt function
const printReceipt = async (penjualan) => {
  try {
    // Format transaction data untuk printer
    const transactionData = {
      nomor_transaksi: penjualan.nomor_transaksi,
      tanggal: penjualan.tanggal_transaksi,
      kasir: penjualan.user?.name || '-',
      pelanggan: penjualan.buyer?.name || penjualan.nama_pelanggan || '-',
      items: penjualan.items.map(item => ({
        nama: item.nama_barang,
        qty: item.qty,
        harga_satuan: item.harga_satuan,
        subtotal: item.subtotal
      })),
      subtotal: penjualan.subtotal,
      diskon: penjualan.diskon || 0,
      potongan_poin: 0, // Not stored in penjualan, could add if needed
      total: penjualan.total,
      bayar: penjualan.bayar,
      kembalian: penjualan.kembalian,
      metode_pembayaran: penjualan.metode_pembayaran,
      poin_didapat: 0 // Not stored in penjualan, could calculate if needed
    }

    await printThermalReceipt(transactionData)
    toast.success('Struk berhasil dicetak!')
  } catch (error) {
    console.error('Print error:', error)
    toast.error('Gagal mencetak struk')
  }
}
</script>

